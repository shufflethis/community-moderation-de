{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "_comment": "Die Accept-Aushandlung steckt in middleware.ts – Rewrites hier greifen erst nach dem Dateisystem und kämen für vorhandene Seiten nie zum Zug. Hier stehen nur fremdsprachige Aliase und Header.",
  "rewrites": [
    { "source": "/:alias(about|about-us)", "destination": "/ueber-uns/index.html" },
    { "source": "/:alias(about|about-us)/", "destination": "/ueber-uns/index.html" },
    { "source": "/contact", "destination": "/kontakt/index.html" },
    { "source": "/contact/", "destination": "/kontakt/index.html" },
    { "source": "/:alias(privacy|privacy-policy)", "destination": "/datenschutz/index.html" },
    { "source": "/:alias(privacy|privacy-policy)/", "destination": "/datenschutz/index.html" },
    { "source": "/:alias(imprint|legal)", "destination": "/impressum/index.html" },
    { "source": "/:alias(imprint|legal)/", "destination": "/impressum/index.html" }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [{ "key": "Vary", "value": "Accept, Accept-Encoding" }]
    },
    {
      "source": "/:slug(social-media-moderation|community-management-agentur|krisenkommunikation-social-media|ueber-uns|kontakt|impressum|datenschutz|about|about-us|contact|privacy|privacy-policy|imprint|legal)",
      "headers": [{ "key": "Vary", "value": "Accept, Accept-Encoding" }]
    },
    {
      "source": "/:slug(social-media-moderation|community-management-agentur|krisenkommunikation-social-media|ueber-uns|kontakt|impressum|datenschutz|about|about-us|contact|privacy|privacy-policy|imprint|legal)/",
      "headers": [{ "key": "Vary", "value": "Accept, Accept-Encoding" }]
    },
    {
      "source": "/index.md",
      "headers": [
        { "key": "Vary", "value": "Accept, Accept-Encoding" },
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" }
      ]
    },
    {
      "source": "/:slug/index.md",
      "headers": [
        { "key": "Vary", "value": "Accept, Accept-Encoding" },
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" }
      ]
    },
    {
      "source": "/:file(llms.txt|llms-full.txt)",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    },
    {
      "source": "/.well-known/agent-card.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
