---
import BaseLayout from './BaseLayout.astro';
import { SITE, wa } from '../config';

interface Props {
  title: string;
  description: string;
  slug: string;
  eyebrow: string;
  heading: string;
  lead: string;
  image: string;
  imageAlt: string;
  waText: string;
}
const { title, description, slug, eyebrow, heading, lead, image, imageAlt, waText } = Astro.props;
const canonical = `${SITE}/${slug}/`;
const crumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Community Moderation', item: SITE + '/' },
    { '@type': 'ListItem', position: 2, name: heading, item: canonical },
  ],
};
---
<BaseLayout title={title} description={description} canonical={canonical} ctaText={waText}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(crumbs)}></script>

  <section class="sub-hero">
    <div class="wrap">
      <nav class="crumb" aria-label="Brotkrumen"><a href="/">Community Moderation</a> <span aria-hidden="true">/</span> <span>{heading}</span></nav>
      <p class="eyebrow">{eyebrow}</p>
      <h1>{heading}</h1>
      <p class="lead">{lead}</p>
      <div class="sub-actions">
        <a class="btn btn-wa" href={wa(waText)} rel="noopener">Per WhatsApp fragen</a>
        <a class="btn btn-ghost" href="/#check">Selbst-Check starten</a>
      </div>
      <figure class="figure"><img src={image} width="1400" height="933" alt={imageAlt} loading="eager" decoding="async" /></figure>
    </div>
  </section>

  <hr class="rule" />

  <section>
    <div class="wrap sub-body"><slot /></div>
  </section>

  <section class="sub-cta">
    <div class="wrap narrow">
      <h2>Zurück zum Überblick</h2>
      <p class="lead" style="margin-top:18px">
        Diese Seite ist ein Ausschnitt. Wie ausgelagerte Community Moderation im Ganzen aussieht –
        Leistungen, rechtlicher Rahmen, Ablauf und Kosten – steht auf der Startseite.
      </p>
      <p style="margin-top:26px"><a class="btn btn-ghost" href="/">Zur Community Moderation im Überblick</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .sub-hero { padding: clamp(40px, 5vw, 70px) 0 clamp(56px, 7vw, 90px); position: relative; }
  .sub-hero::before {
    content: '';
    position: absolute; top: -200px; left: 50%;
    width: min(1000px, 100vw); height: 540px; transform: translateX(-50%);
    background: radial-gradient(ellipse at center, rgba(110, 91, 255, 0.18), transparent 62%);
    pointer-events: none;
  }
  .crumb { font-size: 0.83rem; color: var(--muted); margin-bottom: 26px; }
  .crumb a { color: var(--accent-soft); text-decoration: none; }
  .crumb span[aria-hidden] { margin: 0 8px; color: var(--line); }
  .sub-hero h1 { font-size: clamp(2.5rem, 6vw, 5rem); max-width: 18ch; }
  .sub-hero .lead { margin-top: 26px; max-width: 62ch; }
  .sub-actions { display: flex; flex-wrap: wrap; gap: 13px; margin-top: 32px; }
  .sub-hero .figure { margin-top: clamp(38px, 5vw, 64px); }

  .sub-body { max-width: 900px; color: var(--muted); font-size: 1.03rem; }
  .sub-body :global(h2) { color: var(--ink); font-size: clamp(1.7rem, 3.2vw, 2.5rem); margin: 52px 0 18px; }
  .sub-body :global(h2:first-child) { margin-top: 0; }
  .sub-body :global(h3) { color: var(--ink); font-size: 1.18rem; margin: 30px 0 10px; }
  .sub-body :global(p) { margin: 0 0 1.15em; }
  .sub-body :global(strong) { color: var(--ink); }
  .sub-body :global(a) { color: var(--accent-soft); }
  .sub-body :global(ul) { margin: 0 0 1.4em; padding: 0; list-style: none; display: grid; gap: 11px; }
  .sub-body :global(li) { display: flex; gap: 12px; }
  .sub-body :global(li)::before { content: '→'; color: var(--accent-soft); flex: none; }
  .sub-body :global(.tiles) { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin: 34px 0 44px; }
  .sub-body :global(.tiles > div) { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r); padding: 24px; }
  .sub-body :global(.tiles b) { display: block; font-family: var(--display); font-size: 1.16rem; letter-spacing: -0.02em; color: var(--ink); margin-bottom: 9px; }
  .sub-body :global(.tiles p) { font-size: 0.93rem; margin: 0; }

  .sub-cta { border-top: 1px solid var(--line); }
  @media (max-width: 820px) {
    .sub-body :global(.tiles) { grid-template-columns: 1fr; }
  }
</style>
