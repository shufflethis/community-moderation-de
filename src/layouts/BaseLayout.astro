---
interface Props { title: string; description: string; canonical?: string; }
const { title, description, canonical = 'https://community-moderation.de/' } = Astro.props;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <link rel="icon" href="/images/famefact-logo.webp" />
    <title>{title}</title>
    <style is:global>
      @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,600;8..60,700&display=swap');
      :root{--ink:#172119;--forest:#0d3528;--lime:#b9db00;--cream:#f7f5ef;--paper:#fffefb;--mist:#e5eadf;--muted:#5c675e;--orange:#ff6d38;--max:1180px}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--cream);color:var(--ink);font-family:'DM Sans',Arial,sans-serif;line-height:1.55}a{color:inherit}.wrap{max-width:var(--max);margin:auto;padding:0 24px}.skip{position:absolute;left:-999px}.skip:focus{left:12px;top:12px;z-index:10;background:#fff;padding:10px}.nav{padding:20px 0;background:rgba(247,245,239,.96);border-bottom:1px solid #dfe4da;position:sticky;top:0;z-index:5}.nav .wrap{display:flex;align-items:center;justify-content:space-between;gap:22px}.brand{display:flex;align-items:center;gap:12px;text-decoration:none;font-weight:700;font-size:1.03rem}.brand img{width:116px;height:auto}.navlinks{display:flex;align-items:center;gap:20px;font-size:.9rem}.navlinks a{text-decoration:none}.button{display:inline-flex;min-height:46px;align-items:center;justify-content:center;padding:11px 18px;border-radius:4px;text-decoration:none;font-weight:700;background:var(--lime);color:#152008;border:1px solid var(--lime);transition:.2s}.button:hover{transform:translateY(-2px);background:#d2f515}.button.dark{background:var(--forest);border-color:var(--forest);color:#fff}.eyebrow{font-size:.76rem;letter-spacing:.11em;text-transform:uppercase;font-weight:700;color:#527161}.display{font-family:'Source Serif 4',Georgia,serif;line-height:.98;letter-spacing:-.035em}.footer{background:var(--forest);color:#ecf0e8;padding:52px 0 28px;margin-top:80px}.footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr;gap:30px}.footer a{color:inherit}.footer small{display:block;margin-top:45px;border-top:1px solid #3d6053;padding-top:18px;color:#bdd0c5}@media(max-width:760px){.navlinks a:not(.button){display:none}.nav .wrap{padding:0 16px}.wrap{padding:0 18px}.footer-grid{grid-template-columns:1fr}.navlinks{gap:8px}.brand img{width:96px}}
    </style>
  </head><body>
    <a class="skip" href="#content">Zum Inhalt springen</a>
    <header class="nav"><div class="wrap"><a class="brand" href="/"><img src="/images/famefact-logo.webp" alt="famefact" /> <span>Community Moderation</span></a><nav class="navlinks" aria-label="Hauptnavigation"><a href="/#leistungen">Leistungen</a><a href="/#cases">Cases</a><a href="/#ablauf">Ablauf</a><a href="/community-management-agentur/">Agentur</a><a class="button" href="#kontakt">Erstberatung</a></nav></div></header>
    <main id="content"><slot /></main>
    <footer class="footer"><div class="wrap footer-grid"><div><img src="/images/famefact-logo.webp" alt="famefact" width="120" /><p>Community Moderation von famefact: für Marken, deren Gespräche schneller wachsen als ihr interner Support.</p></div><div><strong>Leistungen</strong><p><a href="/community-management-agentur/">Community Management</a><br/><a href="/social-media-moderation/">Social Media Moderation</a><br/><a href="/krisenkommunikation-social-media/">Krisenkommunikation</a></p></div><div><strong>Kontakt</strong><p><a href="tel:+4930403665430">030 403 665 430</a><br/><a href="mailto:info@famefact.com">info@famefact.com</a><br/><a href="https://famefact.com/impressum/">Impressum & Datenschutz</a></p></div><small>community-moderation.de wird von famefact betrieben. Berlin · deutschlandweit</small></div></footer>
  </body>
</html>
