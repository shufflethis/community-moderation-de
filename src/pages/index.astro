    transform: translateX(-50%);
    background: radial-gradient(ellipse at center, rgba(110, 91, 255, 0.22), transparent 62%);
    pointer-events: none;
  }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(320px, 0.85fr); gap: clamp(40px, 6vw, 90px); align-items: center; }
  .hero h1 em { font-style: normal; color: var(--accent-soft); }
  .hero .lead { margin-top: 28px; max-width: 58ch; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 36px; }
  .hero-micro { margin-top: 20px; font-size: 0.88rem; color: var(--muted); }

  .hero-thread { background: var(--surface); border: 1px solid var(--line); border-radius: 22px; padding: 20px; }
  .thread-head { display: flex; align-items: center; gap: 9px; font-size: 0.74rem; letter-spacing: 0.09em; text-transform: uppercase; color: var(--muted); padding: 0 4px 16px; border-bottom: 1px solid var(--line); margin-bottom: 18px; }
  .thread-head .dot { width: 8px; height: 8px; border-radius: 50%; background: #29d17c; box-shadow: 0 0 0 4px rgba(41, 209, 124, 0.16); }
  .hero-thread .bubble { animation: pop 0.55s var(--d, 0s) both ease-out; }
  @keyframes pop { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }

  .trustbar { display: flex; flex-wrap: wrap; align-items: center; gap: 26px 46px; margin-top: clamp(48px, 6vw, 84px); padding: 26px 0 0; border-top: 1px solid var(--line); }
  .trustbar > div:not(.logos) { display: flex; flex-direction: column; }
  .trustbar b { font-family: var(--display); font-size: 1.32rem; letter-spacing: -0.03em; }
  .trustbar span { font-size: 0.82rem; color: var(--muted); }
  .trustbar .logos { display: flex; flex-wrap: wrap; gap: 10px 22px; margin-left: auto; font-size: 0.85rem; font-weight: 600; letter-spacing: 0.04em; color: #6b6d80; }

  /* ---------- Section-Kopf ---------- */
  .sec-head { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 30px; align-items: start; margin-bottom: 56px; }
  .sec-head .eyebrow { margin: 8px 0 0; }

  .prose { color: var(--muted); font-size: 1.03rem; }
  .prose.two-col { columns: 2; column-gap: 56px; }
  .prose.two-col p { break-inside: avoid; }
  .prose em { color: var(--ink); font-style: normal; font-weight: 600; }

  /* ---------- Reibungspunkte ---------- */
  .friction { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; margin-top: 54px; }
  .friction article { border-top: 2px solid var(--signal); padding-top: 18px; }
  .friction b { display: block; font-family: var(--display); font-size: 1.35rem; letter-spacing: -0.03em; margin-bottom: 10px; }
  .friction p { font-size: 0.93rem; color: var(--muted); }

  .ki-grid { margin-top: 52px; }
  .ki-grid article.ok { border-top-color: var(--accent); }
  .ki-grid article.no { border-top-color: var(--signal); }
  .ki-grid article.no b { color: var(--signal); }

  /* ---------- Was intern bleibt ---------- */
  .keep { margin-top: 48px; border: 1px solid var(--line); border-radius: var(--r); background: var(--surface); padding: clamp(26px, 3.4vw, 40px); max-width: 900px; }
  .keep h3 { margin-bottom: 16px; }
  .keep p { color: var(--muted); font-size: 0.99rem; }
  .keep strong { color: var(--ink); }

  /* ---------- Definition ---------- */
  .definition-card { border-left: 3px solid var(--accent); background: linear-gradient(90deg, var(--accent-dim), transparent 70%); padding: 28px 30px; border-radius: 0 var(--r) var(--r) 0; }
  .definition-card .def { font-size: clamp(1.05rem, 1.55vw, 1.3rem); line-height: 1.55; margin: 0; }
  .definition-card b { color: var(--accent-soft); }

  .compare { margin-top: 52px; border-top: 1px solid var(--line); }
  .crow { display: grid; grid-template-columns: 1.1fr 2fr 0.6fr; gap: 20px; padding: 18px 4px; border-bottom: 1px solid var(--line); font-size: 0.96rem; color: var(--muted); }
  .crow.chead { font-size: 0.72rem; letter-spacing: 0.13em; text-transform: uppercase; color: #6b6d80; }
  .crow b { color: var(--ink); }
  .crow span:last-child { text-align: right; font-variant-numeric: tabular-nums; }

  /* ---------- Module ---------- */
  .modules { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
  .mod-card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r); padding: 30px; position: relative; transition: border-color 0.2s, transform 0.2s; }
  .mod-card:hover { border-color: var(--accent); transform: translateY(-3px); }
  .mod-no { position: absolute; top: 26px; right: 28px; font-family: var(--display); font-size: 2.1rem; color: var(--line); letter-spacing: -0.04em; }
  .mod-card h3 { margin: 0 0 14px; padding-right: 60px; }
  .mod-card p { font-size: 0.97rem; color: var(--muted); }
  .mod-out { margin-top: 16px; padding-top: 14px; border-top: 1px solid var(--line); font-size: 0.9rem !important; color: var(--ink) !important; }
  .mod-out span { display: inline-block; font-size: 0.68rem; letter-spacing: 0.13em; text-transform: uppercase; color: var(--accent-soft); margin-right: 9px; }

  .figure { margin: 0; }
  .figure img { border-radius: var(--r); border: 1px solid var(--line); width: 100%; }
  .figure figcaption { margin-top: 12px; font-size: 0.87rem; color: var(--muted); }
  .figure.wide { margin-top: 44px; }

  /* ---------- Kanäle ---------- */
  .channels { border-top: 1px solid var(--line); }
  .ch { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 30px; padding: 24px 4px; border-bottom: 1px solid var(--line); align-items: baseline; }
  .ch b { font-family: var(--display); font-size: 1.42rem; letter-spacing: -0.03em; }
  .ch p { font-size: 0.99rem; color: var(--muted); }

  /* ---------- Check ---------- */
  .check-sec { background: linear-gradient(180deg, transparent, rgba(110, 91, 255, 0.05), transparent); }
  .check { padding: 0; overflow: hidden; }
  .check-progress { height: 3px; background: var(--line); }
  .check-bar { height: 100%; width: 0; background: var(--accent); transition: width 0.35s ease; }
  .check-stage, .check-result { padding: clamp(26px, 4vw, 46px); }
  .check-step { font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent-soft); margin: 0 0 14px; }
  .check h3 { margin-bottom: 26px; max-width: 24ch; }
  /* Alles unterhalb entsteht zur Laufzeit per JS und trägt deshalb kein
     Astro-Scope-Attribut — die Regeln müssen global sein, sonst greifen sie nicht. */
  .check-opts { display: grid; gap: 11px; max-width: 640px; }
  :global(.check-opt) { display: flex; align-items: center; gap: 14px; width: 100%; text-align: left; background: var(--surface-2); border: 1px solid var(--line); color: var(--ink); border-radius: 12px; padding: 15px 18px; font: 500 1rem/1.35 var(--sans); cursor: pointer; transition: border-color 0.15s, background 0.15s, transform 0.15s; }
  :global(.check-opt:hover) { border-color: var(--accent); background: #1d1f2b; transform: translateX(3px); }
  :global(.check-opt i) { flex: none; width: 22px; height: 22px; border-radius: 50%; border: 1px solid var(--line); font: 600 0.7rem/21px var(--sans); font-style: normal; text-align: center; color: var(--muted); }
  :global(.check-back) { margin-top: 20px; background: none; border: 0; color: var(--muted); font: 500 0.88rem var(--sans); cursor: pointer; padding: 4px 0; }
  :global(.check-back:hover) { color: var(--ink); }
  :global(.res-score) { font-family: var(--display); font-weight: 700; font-size: clamp(2.1rem, 4.4vw, 3.2rem); letter-spacing: -0.04em; line-height: 1.03; margin: 0 0 18px; color: var(--ink); max-width: 20ch; }
  :global(.res-label) { font-size: 0.74rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent-soft); margin: 0 0 16px; font-weight: 600; }
  :global(.res-body) { color: var(--muted); max-width: 62ch; margin: 0 0 24px; }
  :global(.res-list) { list-style: none; padding: 0; margin: 0 0 30px; display: grid; gap: 10px; max-width: 62ch; }
  :global(.res-list li) { display: flex; gap: 12px; font-size: 0.95rem; color: var(--muted); }
  :global(.res-list li)::before { content: '→'; color: var(--accent-soft); flex: none; }
  :global(.res-actions) { display: flex; flex-wrap: wrap; gap: 13px; align-items: center; }

  /* ---------- Ablauf ---------- */
  .steps { list-style: none; margin: 0; padding: 0; counter-reset: s; display: grid; gap: 0; border-top: 1px solid var(--line); }
  .steps li { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 30px; padding: 30px 4px; border-bottom: 1px solid var(--line); }
  .st-no { font-size: 0.76rem; letter-spacing: 0.13em; text-transform: uppercase; color: var(--accent-soft); padding-top: 6px; }
  .steps h3 { margin-bottom: 12px; }
  .steps p { font-size: 0.99rem; color: var(--muted); max-width: 68ch; }

  /* ---------- Menschen ---------- */
  .people { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .people figure { margin: 0; }
  .people img { border-radius: 14px; border: 1px solid var(--line); filter: grayscale(1) contrast(1.05); transition: filter 0.3s; width: 100%; }
  .people figure:hover img { filter: none; }
  .people figcaption { margin-top: 13px; }
  .people b { display: block; font-family: var(--display); font-size: 1.16rem; letter-spacing: -0.02em; }
  .people span { font-size: 0.85rem; color: var(--muted); }
  .scenes { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; margin-top: 44px; }

  /* ---------- Recht ---------- */
  .legal-sec { background: linear-gradient(180deg, transparent, rgba(255, 77, 109, 0.045), transparent); }
  .legal-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; margin-top: 52px; }
  .lcard { border: 1px solid var(--line); border-radius: var(--r); padding: 24px; background: var(--surface); }
  .lcard b { display: block; font-family: var(--display); font-size: 1.14rem; letter-spacing: -0.02em; margin-bottom: 10px; color: var(--signal); }
  .lcard p { font-size: 0.92rem; color: var(--muted); }
  .disclaimer { margin-top: 34px; font-size: 0.87rem; color: #75778a; max-width: 78ch; border-left: 2px solid var(--line); padding-left: 18px; }

  /* ---------- Kosten ---------- */
  .drivers { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px 34px; }
  .drivers > div { border-top: 1px solid var(--line); padding-top: 18px; }
  .drivers b { display: block; font-family: var(--display); font-size: 1.24rem; letter-spacing: -0.03em; margin-bottom: 9px; }
  .drivers p { font-size: 0.93rem; color: var(--muted); }
  .cost-note { margin-top: 46px; max-width: 800px; }
  .cost-note h3 { margin-bottom: 14px; }
  .cost-note p { color: var(--muted); margin-bottom: 24px; }

  /* ---------- Referenzen ---------- */
  .ref-logos { display: flex; flex-wrap: wrap; gap: 14px 34px; margin-top: 40px; padding-top: 28px; border-top: 1px solid var(--line); font-weight: 600; letter-spacing: 0.04em; color: #6b6d80; }
  .ref-link { margin-top: 26px; }
  .ref-link a { color: var(--accent-soft); text-decoration: none; font-weight: 600; }
  .ref-link a:hover { text-decoration: underline; }

  /* ---------- FAQ ---------- */
  .faq details { border-bottom: 1px solid var(--line); padding: 20px 0; }
  .faq details:first-child { border-top: 1px solid var(--line); }
  .faq summary { cursor: pointer; font-weight: 600; font-size: 1.06rem; list-style: none; display: flex; justify-content: space-between; gap: 20px; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; color: var(--accent-soft); font-size: 1.4rem; line-height: 1; flex: none; }
  .faq details[open] summary::after { content: '–'; }
  .faq details p { margin-top: 14px; color: var(--muted); max-width: 74ch; }

  /* ---------- CTA ---------- */
  .cta-sec { border-top: 1px solid var(--line); }
  .cta-grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(280px, 0.85fr); gap: clamp(36px, 5vw, 70px); align-items: center; }

  /* ---------- Responsive ---------- */
  @media (max-width: 1040px) {
    .modules, .legal-grid, .friction, .people { grid-template-columns: repeat(2, 1fr); }
    .drivers { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 900px) {
    .hero-grid, .cta-grid { grid-template-columns: 1fr; }
    .sec-head, .ch, .steps li { grid-template-columns: 1fr; gap: 14px; }
    .prose.two-col { columns: 1; }
    .trustbar .logos { margin-left: 0; }
    .scenes { grid-template-columns: 1fr; }
    .crow { grid-template-columns: 1fr; gap: 6px; }
    .crow span:last-child { text-align: left; }
    .crow.chead { display: none; }
  }
  @media (max-width: 640px) {
    .modules, .legal-grid, .friction, .drivers { grid-template-columns: 1fr; }
    .people { grid-template-columns: repeat(2, 1fr); }
    .mod-no { font-size: 1.6rem; top: 22px; right: 22px; }
    .mod-card h3 { padding-right: 44px; }
  }
</style>

<script is:inline>
  (function () {
    var root = document.getElementById('cm-check');
    if (!root) return;
    var waNum = root.getAttribute('data-wa');

    var QUESTIONS = [
      {
        q: 'Auf wie vielen Social-Media-Kanälen seid ihr aktiv?',
        opts: [
          { t: 'Ein Kanal', s: 0 },
          { t: 'Zwei bis drei Kanäle', s: 2 },
          { t: 'Vier bis sechs Kanäle', s: 4 },
          { t: 'Mehr als sechs, inklusive Foren oder Discord', s: 6 },
        ],
      },
      {
        q: 'Wie viele Kommentare und Nachrichten kommen im Monat zusammen?',
        opts: [
          { t: 'Unter 200 – überschaubar', s: 0 },
          { t: '200 bis 1.000', s: 2 },
          { t: '1.000 bis 5.000', s: 4 },
          { t: 'Über 5.000 oder wir wissen es nicht genau', s: 6 },
        ],
      },
      {
        q: 'Wer moderiert heute, wenn die zuständige Person im Urlaub ist?',
        opts: [
          { t: 'Es gibt eine eingearbeitete Vertretung', s: 0 },
          { t: 'Jemand springt ein, ohne wirklich eingearbeitet zu sein', s: 4 },
          { t: 'Dann bleibt es liegen', s: 6 },
        ],
      },
      {
        q: 'Wie sieht es abends, am Wochenende und an Feiertagen aus?',
        opts: [
          { t: 'Ist abgedeckt und geregelt', s: 0 },
          { t: 'Jemand schaut privat mal rein', s: 4 },
          { t: 'Gar nicht abgedeckt', s: 6 },
        ],
      },
      {
        q: 'Gibt es eine schriftliche Netiquette und einen Eskalationsweg?',
        opts: [
          { t: 'Beides existiert und ist aktuell', s: 0 },
          { t: 'Eins von beiden, eher informell', s: 3 },
          { t: 'Weder noch – wir entscheiden im Einzelfall', s: 6 },
        ],
      },
      {
        q: 'Wie häufig wird es auf euren Kanälen ernsthaft unangenehm?',
        opts: [
          { t: 'Selten, meist sachliche Fragen', s: 0 },
          { t: 'Regelmäßig Beschwerden, gelegentlich Beleidigungen', s: 3 },
          { t: 'Häufig Hate Speech oder koordinierte Angriffe', s: 6 },
        ],
      },
    ];

    var PROFILES = [
      {
        max: 10,
        label: 'Profil A',
        title: 'Ihr habt es im Griff.',
        body: 'Euer Volumen und eure Struktur passen zusammen. Externe Moderation würde euch aktuell mehr Abstimmung kosten, als sie euch abnimmt. Sinnvoll wäre höchstens ein Blick von außen auf Netiquette und Eskalationsweg, damit beides auch dann trägt, wenn das Volumen wächst.',
        list: [
          'Netiquette einmal jährlich gegenlesen lassen',
          'Vertretungsregel schriftlich festhalten',
          'Volumen pro Kanal monatlich mitschreiben, um den Kipppunkt zu erkennen',
        ],
      },
      {
        max: 20,
        label: 'Profil B',
        title: 'Es funktioniert – solange nichts passiert.',
        body: 'Ihr schafft das Tagesgeschäft, aber euer Setup hat keine Reserve. Urlaub, ein viraler Beitrag oder eine unglückliche Kampagne reichen aus, um die Moderation für ein paar Tage kippen zu lassen. Eine Teilabdeckung – etwa Abende und Wochenenden – bringt hier das beste Verhältnis aus Aufwand und Wirkung.',
        list: [
          'Abdeckung für Abende und Wochenenden extern ergänzen',
          'Antwortbibliothek für die 20 häufigsten Fragen aufbauen',
          'Eskalationsweg mit benannten Empfängern und Fristen festschreiben',
        ],
      },
      {
        max: 999,
        label: 'Profil C',
        title: 'Hier fehlt eine Struktur, nicht eine Person.',
        body: 'Volumen, fehlende Vertretung und fehlendes Regelwerk kommen bei euch zusammen. Das ist der Punkt, an dem interne Lösungen fast immer scheitern – nicht an Motivation, sondern an Kapazität und an fehlender Dokumentation. Sinnvoll ist eine vollständige Übernahme der Moderation inklusive Regelwerk, Protokollierung und festem Kernteam.',
        list: [
          'Bestandsaufnahme mit echten Volumenzahlen pro Kanal und Tageszeit',
          'Netiquette veröffentlichen und Moderationsleitfaden schreiben',
          'Protokollierung für jede Ausblendung einführen',
          'Festes Kernteam mit Vertretung und verbindlichem Abdeckungsfenster',
        ],
      },
    ];

    var idx = 0;
    var answers = [];
    var elStep = document.getElementById('cm-step');
    var elQ = document.getElementById('cm-q');
    var elOpts = document.getElementById('cm-opts');
    var elBar = document.getElementById('cm-bar');
    var elStage = document.getElementById('cm-stage');
    var elResult = document.getElementById('cm-result');

    function render() {
      var q = QUESTIONS[idx];
      elStep.textContent = 'Frage ' + (idx + 1) + ' von ' + QUESTIONS.length;
      elQ.textContent = q.q;
      elBar.style.width = (idx / QUESTIONS.length) * 100 + '%';
      elOpts.textContent = '';
      q.opts.forEach(function (o, i) {
        var b = document.createElement('button');
        b.type = 'button';
        b.className = 'check-opt';
        var mark = document.createElement('i');
        mark.textContent = String.fromCharCode(65 + i);
        b.appendChild(mark);
        b.appendChild(document.createTextNode(o.t));
        b.addEventListener('click', function () {
          answers[idx] = o;
          idx++;
          if (idx >= QUESTIONS.length) finish();
          else render();
        });
        elOpts.appendChild(b);
      });
      if (idx > 0) {
        var back = document.createElement('button');
        back.type = 'button';
        back.className = 'check-back';
        back.textContent = '← eine Frage zurück';
        back.addEventListener('click', function () { idx--; render(); });
        elOpts.appendChild(back);
      }
    }

    function finish() {
      var score = answers.reduce(function (a, o) { return a + o.s; }, 0);
      var p = PROFILES.filter(function (x) { return score <= x.max; })[0];
      elBar.style.width = '100%';
      elStage.hidden = true;
      elResult.hidden = false;

      var msg =
        'Hallo famefact, wir haben den Selbst-Check auf community-moderation.de gemacht.\n\n' +
        'Ergebnis: ' + p.label + ' – ' + p.title + ' (' + score + ' von 36 Punkten)\n\n' +
        'Unsere Antworten:\n' +
        QUESTIONS.map(function (q, i) { return '• ' + q.q + '\n  ' + answers[i].t; }).join('\n') +
        '\n\nKönnen wir dazu kurz sprechen?';

      elResult.textContent = '';

      var lbl = document.createElement('p');
      lbl.className = 'res-label';
      lbl.textContent = p.label + ' · ' + score + ' von 36 Punkten';
      elResult.appendChild(lbl);

      var h = document.createElement('p');
      h.className = 'res-score display';
      h.textContent = p.title;
      elResult.appendChild(h);

      var body = document.createElement('p');
      body.className = 'res-body';
      body.textContent = p.body;
      elResult.appendChild(body);

      var ul = document.createElement('ul');
      ul.className = 'res-list';
      p.list.forEach(function (t) {
        var li = document.createElement('li');
        li.appendChild(document.createTextNode(t));
        ul.appendChild(li);
      });
      elResult.appendChild(ul);

      var acts = document.createElement('div');
      acts.className = 'res-actions';
      var a = document.createElement('a');
      a.className = 'btn btn-wa';
      a.rel = 'noopener';
      a.href = 'https://wa.me/' + waNum + '?text=' + encodeURIComponent(msg);
      a.textContent = 'Ergebnis per WhatsApp schicken';
      acts.appendChild(a);
      var again = document.createElement('button');
      again.type = 'button';
      again.className = 'btn btn-ghost';
      again.textContent = 'Nochmal ausfüllen';
      again.addEventListener('click', function () {
        idx = 0; answers = []; elResult.hidden = true; elStage.hidden = false; render();
      });
      acts.appendChild(again);
      elResult.appendChild(acts);

      var note = document.createElement('p');
      note.className = 'muted';
      note.style.marginTop = '20px';
      note.style.fontSize = '.85rem';
      note.textContent = 'Das Ergebnis wurde nirgends gespeichert. Erst wenn ihr auf den Button klickt, verlassen die Angaben euer Gerät – dann als Nachricht, die ihr vorher lesen könnt.';
      elResult.appendChild(note);
      elResult.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    }

    render();
  })();
</script>
