---
import BaseLayout from '../layouts/BaseLayout.astro';
const schema = { '@context':'https://schema.org', '@type':'ProfessionalService', name:'famefact – Community Moderation', url:'https://community-moderation.de/', telephone:'+4930403665430', email:'info@famefact.com', areaServed:{'@type':'Country',name:'Deutschland'}, address:{'@type':'PostalAddress',addressLocality:'Berlin',addressCountry:'DE'}, parentOrganization:{'@type':'Organization',name:'famefact',url:'https://famefact.com/'}, serviceType:['Community Management','Social Media Moderation','Krisenkommunikation'] };
const faq = { '@context':'https://schema.org', '@type':'FAQPage', mainEntity:[
{'@type':'Question',name:'Was macht professionelle Community Moderation?',acceptedAnswer:{'@type':'Answer',text:'Professionelle Moderation beantwortet Anfragen, sortiert Feedback, deeskaliert Konflikte und leitet relevante Fälle nach klaren Regeln an die richtigen Teams weiter.'}},
{'@type':'Question',name:'Kann famefact auch außerhalb der Bürozeiten moderieren?',acceptedAnswer:{'@type':'Answer',text:'Der passende Serviceumfang wird nach Kanal, Community-Volumen, Sprachen und Eskalationsbedarf individuell definiert.'}},
{'@type':'Question',name:'Welche Kanäle moderiert ihr?',acceptedAnswer:{'@type':'Answer',text:'Wir entwickeln Moderationsprozesse für die relevanten Social-Media-Kanäle und Communities einer Marke – inklusive Eskalationswegen und Reporting.'}}]};
---
<BaseLayout title="Community Moderation Agentur | Social Media Moderation deutschlandweit" description="Community Moderation für Social Media: Anfragen beantworten, Konflikte deeskalieren, Marken schützen. Ein Service von famefact aus Berlin – deutschlandweit.">
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)}></script><script is:inline type="application/ld+json" set:html={JSON.stringify(faq)}></script>
  <section class="hero"><div class="wrap hero-grid"><div><p class="eyebrow">famefact · Berlin & deutschlandweit</p><h1 class="display">Community Moderation, die Gespräche <em>weiterbringt.</em></h1><p class="lead">Deine Community verdient Antworten – nicht Warteschleifen. Wir moderieren Social Media mit Haltung, klaren Prozessen und einem Team, das deine Marke versteht.</p><div class="actions"><a class="button" href="#kontakt">Kostenlose Erstberatung</a><a class="phone" href="tel:+4930403665430">oder direkt: 030 403 665 430</a></div><p class="micro">Für Marken, Teams und Plattformen mit Anspruch an Service, Tonalität und Sicherheit.</p></div><aside class="hero-aside" aria-label="Unsere Moderationsprinzipien"><span>01</span><strong>zuhören</strong><span>02</span><strong>einordnen</strong><span>03</span><strong>handeln</strong><p>Vom Kommentar bis zur Eskalation: Jede Antwort hat einen Zweck.</p></aside></div></section>
  <section class="proof"><div class="wrap"><p class="eyebrow">Erfahrung, auf die du aufbauen kannst</p><p>Seit 2009 entwickelt famefact Social-Media-Strategien, Inhalte, Communities und Kampagnen für Unternehmen und Marken.</p><div class="logos"><span>Vattenfall</span><span>Casio</span><span>REWE</span><span>Autohero</span><span>Fleurop</span><span>Oxford</span></div></div></section>
  <section id="leistungen" class="services"><div class="wrap"><div class="section-head"><p class="eyebrow">Was dein Team entlastet</p><h2 class="display">Keine Copy-Paste-Antworten. Ein System, das zu deiner Marke passt.</h2></div><div class="service-list"><article><b>01 / Moderation</b><h3>Antworten, die Menschen ernst nehmen.</h3><p>Wir pflegen den Dialog in deiner Tonalität, beantworten wiederkehrende Fragen und halten Gespräche konstruktiv.</p><a href="/social-media-moderation/">Social Media Moderation ansehen →</a></article><article><b>02 / Community Management</b><h3>Aus Reichweite wird Beziehung.</h3><p>Wir erkennen Themen, bündeln Feedback und schaffen Routinen, die aus einer Audience eine belastbare Community machen.</p><a href="/community-management-agentur/">Community Management ansehen →</a></article><article><b>03 / Eskalation</b><h3>Ruhig bleiben, wenn es laut wird.</h3><p>Mit abgestimmten Leitlinien, Reaktionswegen und Reporting behalten Marke und Fachteam in kritischen Situationen die Kontrolle.</p><a href="/krisenkommunikation-social-media/">Krisenkommunikation ansehen →</a></article></div></div></section>
  <section id="cases" class="cases"><div class="wrap"><div class="section-head"><p class="eyebrow">Aus dem famefact-Portfolio</p><h2 class="display">Social Media ist dort stark, wo Strategie und Dialog zusammenkommen.</h2></div><div class="case-grid"><a href="https://famefact.com/portfolio/marketingstrategie-autohaus-mercedes-berlin/" class="case"><img src="/images/mercedes-berlin.png" alt="Social Media für Mercedes-Benz Berlin – Case aus dem famefact-Portfolio"/><span>Case / Automotive</span><h3>Social Media für Mercedes-Benz Berlin</h3><p>Strategie, Inhalte und Austausch an den relevanten Touchpoints.</p></a><a href="https://famefact.com/portfolio/carado-geo-reddit-strategie/" class="case"><img src="/images/wewatch-social-recruiting.png" alt="Employer Branding für WeWatch Security – Case aus dem famefact-Portfolio"/><span>Case / Community & Recruiting</span><h3>Employer Branding für WeWatch Security</h3><p>Eine Marke im Dialog mit den Menschen, die sie erreichen will.</p></a></div><p class="case-link"><a href="https://famefact.com/social-media-marketing-beispiele/">Weitere Cases von famefact ansehen →</a></p></div></section>
  <section id="ablauf" class="process"><div class="wrap process-grid"><div><p class="eyebrow">So starten wir</p><h2 class="display">Erst verstehen. Dann passend antworten.</h2></div><ol><li><strong>Community-Check</strong><span>Kanäle, Volumen, Themen, Tonalität und Risiken gemeinsam erfassen.</span></li><li><strong>Moderationssystem</strong><span>Leitfäden, Freigaben und Eskalationswege so bauen, dass sie im Alltag funktionieren.</span></li><li><strong>Dialog & Learnings</strong><span>Moderieren, dokumentieren und die wiederkehrenden Signale für dein Team sichtbar machen.</span></li></ol></div></section>
  <section class="faq"><div class="wrap narrow"><p class="eyebrow">Häufige Fragen</p><h2 class="display">Klarheit vor dem Start.</h2><details><summary>Was umfasst Community Moderation?</summary><p>Wir definieren mit dir Tonalität, Themenfelder, Freigaben und Eskalationsprozesse. Danach moderieren wir im abgestimmten Umfang und machen relevante Entwicklungen nachvollziehbar.</p></details><details><summary>Ist das auch für B2B-Marken sinnvoll?</summary><p>Ja. Gerade bei erklärungsbedürftigen Angeboten wirkt ein kompetenter, schneller Dialog als sichtbarer Vertrauensbeweis.</p></details><details><summary>Wie schnell können wir beginnen?</summary><p>Nach einem Kennenlernen klären wir Kanäle, Umfang und Verantwortlichkeiten. Darauf basiert ein sauberer Startplan statt einer Standardlösung.</p></details></div></section>
  <section class="team"><div class="wrap team-grid"><img src="/images/famefact-team.webp" alt="Das Team von famefact" loading="lazy"/><div><p class="eyebrow">Das Team hinter dem Dialog</p><h2 class="display">Erfahrung aus Berlin. Wirkung in ganz Deutschland.</h2><p>Wir verbinden klare Prozesse mit Menschen, die verstehen, wann eine Community eine schnelle Antwort, eine fachliche Rückfrage oder schlicht ein offenes Ohr braucht.</p><a href="https://famefact.com/ueber-uns/">famefact kennenlernen →</a></div></div></section>
  <section id="kontakt" class="contact"><div class="wrap contact-grid"><div><p class="eyebrow">Unverbindlich starten</p><h2 class="display">Was soll deine Community künftig von dir hören?</h2><p>Erzähl uns kurz, wo Dialoge liegen bleiben oder welche Situation du besser absichern willst. Wir melden uns für ein erstes Gespräch.</p></div><div class="contact-card"><h3>Kostenlose Erstberatung</h3><p><a href="tel:+4930403665430">030 403 665 430</a></p><p><a href="mailto:info@famefact.com?subject=Anfrage%20Community%20Moderation">info@famefact.com</a></p><a class="button" href="https://famefact.com/kontakt/">Kontaktformular öffnen</a><small>Mit dem Klick öffnest du das Kontaktformular von famefact.</small></div></div></section>
</BaseLayout>
<style>
.hero{padding:85px 0 72px;background:var(--paper)}.hero-grid{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(260px,.62fr);gap:80px;align-items:end}.hero h1{font-size:clamp(3.35rem,7vw,6.65rem);max-width:900px;margin:12px 0 26px}.hero h1 em{color:#31735d;font-style:normal}.lead{font-size:1.21rem;max-width:630px;color:#425047}.actions{display:flex;align-items:center;gap:22px;margin-top:33px}.phone{font-weight:700;text-decoration-thickness:1px;text-underline-offset:3px}.micro{font-size:.85rem;color:var(--muted);margin-top:29px}.hero-aside{border-top:2px solid var(--forest);padding-top:17px;display:grid;grid-template-columns:36px 1fr;gap:12px;color:var(--forest)}.hero-aside span{font-size:.8rem}.hero-aside strong{font-size:1.2rem}.hero-aside p{grid-column:1/-1;border-top:1px solid var(--mist);padding-top:17px;color:var(--muted)}.proof{padding:40px 0;background:var(--forest);color:white}.proof .wrap>p:nth-child(2){font:600 clamp(1.25rem,2vw,1.75rem)/1.25 'Source Serif 4',Georgia,serif;max-width:900px;margin:10px 0 34px}.proof .eyebrow{color:#b9db00}.logos{display:flex;flex-wrap:wrap;justify-content:space-between;gap:15px;color:#bccac0;font-weight:700;letter-spacing:.04em}.services,.cases,.process,.faq{padding:100px 0}.section-head{display:grid;grid-template-columns:.55fr 1.45fr;gap:40px;align-items:start}.section-head h2,.process h2,.faq h2,.contact h2{font-size:clamp(2.5rem,4.6vw,4.6rem);margin:0;max-width:860px}.service-list{margin-top:55px;border-top:1px solid #cbd4c9}.service-list article{display:grid;grid-template-columns:.45fr 1fr 1.05fr .75fr;gap:20px;align-items:start;padding:27px 0;border-bottom:1px solid #cbd4c9}.service-list b,.case span{font-size:.77rem;letter-spacing:.08em;text-transform:uppercase;color:#587266}.service-list h3{font:600 1.5rem/1.15 'Source Serif 4',serif;margin:0}.service-list p{margin:0;color:var(--muted)}.service-list a,.case-link a{font-weight:700;text-underline-offset:4px}.cases{background:#e3e9dc}.case-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-top:55px}.case{display:block;background:var(--paper);text-decoration:none;padding:14px 14px 25px;transition:.2s}.case:hover{transform:translateY(-4px)}.case img{display:block;width:100%;aspect-ratio:1.45;object-fit:cover;filter:saturate(.75)}.case span{display:block;margin:19px 8px 5px}.case h3,.case p{margin:0 8px}.case h3{font:600 1.62rem/1.1 'Source Serif 4',serif}.case p{color:var(--muted);margin-top:8px}.case-link{margin-top:28px}.process{background:var(--orange);color:#1c241d}.process-grid{display:grid;grid-template-columns:1fr 1.1fr;gap:80px}.process .eyebrow{color:#513323}.process ol{list-style:none;margin:0;padding:0}.process li{display:grid;grid-template-columns:1fr 1.3fr;padding:18px 0;border-top:1px solid rgba(0,0,0,.3);gap:20px}.process li span{color:#3e342b}.narrow{max-width:850px}.faq details{border-top:1px solid #cbd4c9;padding:19px 0}.faq details:last-child{border-bottom:1px solid #cbd4c9}.faq summary{cursor:pointer;font-weight:700;font-size:1.08rem}.faq details p{color:var(--muted);max-width:700px}.team{padding:85px 0;background:var(--paper)}.team-grid{display:grid;grid-template-columns:1.12fr .88fr;gap:65px;align-items:center}.team img{width:100%;display:block}.team h2{font-size:clamp(2.4rem,4.4vw,4.4rem);margin:8px 0 19px}.team p:not(.eyebrow){color:var(--muted);font-size:1.08rem}.team a{font-weight:700;text-underline-offset:4px}.contact{padding:85px 0 0}.contact-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:80px;align-items:center}.contact-card{background:var(--forest);padding:34px;color:#fff}.contact-card h3{font:600 1.65rem 'Source Serif 4',serif;margin:0}.contact-card p a{font-size:1.1rem;font-weight:700}.contact-card small{display:block;margin-top:15px;color:#bcd0c2}@media(max-width:760px){.hero{padding:58px 0}.hero-grid,.section-head,.process-grid,.team-grid,.contact-grid{grid-template-columns:1fr;gap:34px}.hero h1{font-size:3.4rem}.actions{align-items:flex-start;flex-direction:column;gap:14px}.service-list article{grid-template-columns:1fr;gap:12px}.case-grid{grid-template-columns:1fr}.services,.cases,.process,.faq{padding:70px 0}.logos{justify-content:flex-start;gap:18px 28px}.process li{grid-template-columns:1fr}.contact{padding-top:65px}}
</style>
